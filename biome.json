{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": ["**", "!docs", "!**/convex/_generated", "!**/next-env.d.ts"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "error"
      },
      "style": {
        "noEnum": "error",
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "nepali-date-converter": "Use @mero-pasal/shared/dates (code-standard §4).",
              "convex/server": {
                "importNames": ["queryGeneric", "mutationGeneric", "actionGeneric"],
                "message": "Use the auth wrappers in convex/lib/functions.ts (AGENTS.md rule 4)."
              }
            },
            "patterns": [
              {
                "group": ["**/_generated/server", "**/_generated/server.js"],
                "importNamePattern": "(query|mutation|action)",
                "message": "Use the auth wrappers in convex/lib/functions.ts (AGENTS.md rule 4)."
              }
            ]
          }
        }
      }
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["packages/backend/convex/lib/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "nepali-date-converter": "Use @mero-pasal/shared/dates (code-standard §4).",
                  "convex/server": {
                    "importNames": ["queryGeneric", "mutationGeneric", "actionGeneric"],
                    "message": "Use the auth wrappers in convex/lib/functions.ts (AGENTS.md rule 4)."
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/shared/src/dates/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": "off"
          }
        }
      }
    }
  ]
}
