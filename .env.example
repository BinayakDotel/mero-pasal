# Documents every env var. No values here; real ones go in .env.local (git-ignored).
# See docs/architecture-context.md §11.

# apps/web/.env.local
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
CLERK_SECRET_KEY=

# packages/backend/.env.local is written by `convex dev` (CONVEX_DEPLOYMENT, CONVEX_URL)

# Convex dashboard → Settings → Environment Variables (not a file)
# CLERK_JWT_ISSUER_DOMAIN=

# Vercel project settings only
# CONVEX_DEPLOY_KEY=

# v2 only, Convex env
# ANTHROPIC_API_KEY=
